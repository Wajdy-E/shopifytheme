{% doc %}
    Renders the "Image tiles" mega menu style: a grid of image-led
    category cards. Tiles come primarily from `mega_promo` section
    blocks whose `parent_position` matches the given top-level menu
    position.

    Falls back to the legacy `Title|image.jpg` link-title convention
    in second-level children if no `mega_promo` blocks target this
    parent position. As a last resort, falls back to a plain text grid.

    @param {object} section - The parent section object (passed from sections/navbar.liquid).
    @param {object} link - The top-level menu link.
    @param {number} parent_position - 1-based position of the link in the desktop menu.
{% enddoc %}

{%- liquid
    assign max_cols = section.settings.mega_menu_max_cols | default: 4
    assign font_classes = section.settings.menu_desktop_font_family | append: ' fs-' | append: section.settings.menu_desktop_font_size

    assign all_promos = section.blocks | where: 'type', 'mega_promo'
    assign promo_count = 0
    for promo in all_promos
        if promo.settings.parent_position == parent_position
            assign promo_count = promo_count | plus: 1
        endif
    endfor

    assign legacy_count = 0
    for child_link in link.links
        if child_link.title contains '.jpg' or child_link.title contains '.png' or child_link.title contains 'product'
            assign legacy_count = legacy_count | plus: 1
        endif
    endfor
-%}

<div class="mega-tiles">
    {%- if promo_count > 0 -%}
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-{{ max_cols }} g-3">
            {%- for promo in all_promos -%}
                {%- if promo.settings.parent_position != parent_position -%}{%- continue -%}{%- endif -%}
                <div class="col" {{ promo.shopify_attributes }}>
                    <a
                        class="mega-tile d-block text-decoration-none h-100 position-relative overflow-hidden rounded"
                        href="{{ promo.settings.link | default: '#' }}"
                    >
                        {%- if promo.settings.image -%}
                            {{ promo.settings.image | image_url: width: 600 | image_tag:
                                class: 'mega-tile__img w-100 h-100 object-fit-cover',
                                widths: '300, 600, 900',
                                sizes: '(max-width: 768px) 50vw, 25vw',
                                loading: 'lazy',
                                alt: promo.settings.image.alt | default: promo.settings.heading
                            }}
                        {%- else -%}
                            <div class="mega-tile__placeholder bg-body-secondary"></div>
                        {%- endif -%}

                        <div class="mega-tile__overlay"></div>

                        <div class="mega-tile__caption position-absolute bottom-0 start-0 end-0 p-3 text-white">
                            {%- if promo.settings.heading != blank -%}
                                <h6 class="mega-tile__heading mb-0 {{ font_classes }}">
                                    {{ promo.settings.heading | escape }}
                                </h6>
                            {%- else -%}
                                <h6 class="mega-tile__heading mb-0 {{ font_classes }}">
                                    {{ link.title | escape }}
                                </h6>
                            {%- endif -%}
                            {%- if promo.settings.subheading != blank -%}
                                <p class="mega-tile__subheading small mb-0 opacity-75">
                                    {{ promo.settings.subheading | escape }}
                                </p>
                            {%- endif -%}
                        </div>
                    </a>
                </div>
            {%- endfor -%}
        </div>
    {%- elsif legacy_count > 0 -%}
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-{{ max_cols }} g-3">
            {%- for child_link in link.links -%}
                {%- liquid
                    assign is_legacy_image = false
                    if child_link.title contains '.jpg' or child_link.title contains '.png' or child_link.title contains 'product'
                        assign is_legacy_image = true
                    endif
                -%}
                {%- unless is_legacy_image -%}{%- continue -%}{%- endunless -%}

                <div class="col">
                    <a
                        class="mega-tile d-block text-decoration-none h-100 position-relative overflow-hidden rounded"
                        href="{{ child_link.url }}"
                    >
                        {%- if child_link.title contains 'product' -%}
                            {%- assign product = child_link.object -%}
                            {%- if product.featured_image -%}
                                <img
                                    class="mega-tile__img w-100 h-100 object-fit-cover"
                                    src="{{ product.featured_image | image_url: width: 480 }}"
                                    alt="{{ product.featured_image.alt | escape }}"
                                    width="480"
                                    height="360"
                                    loading="lazy"
                                >
                            {%- endif -%}
                        {%- else -%}
                            {%- assign image_handle = child_link.title | split: '|' | last | strip -%}
                            {% comment %}theme-check-disable{% endcomment %}
                            <img
                                class="mega-tile__img w-100 h-100 object-fit-cover"
                                src="{{ image_handle | file_img_url: '480x360', crop: 'center' }}"
                                alt=""
                                width="480"
                                height="360"
                                loading="lazy"
                            >
                            {% comment %}theme-check-enable{% endcomment %}
                        {%- endif -%}

                        <div class="mega-tile__overlay"></div>

                        <div class="mega-tile__caption position-absolute bottom-0 start-0 end-0 p-3 text-white">
                            <h6 class="mega-tile__heading mb-0 {{ font_classes }}">
                                {{ child_link.title | split: '|' | first }}
                            </h6>
                        </div>
                    </a>
                </div>
            {%- endfor -%}
        </div>
    {%- else -%}
        {%- render 'navbar-mega-columns', section: section, link: link, parent_position: parent_position -%}
    {%- endif -%}
</div>

{% stylesheet %}
    .mega-tile {
        aspect-ratio: 4 / 3;
        color: #fff;
        background: var(--bs-body-bg-darken-3, #1a1a1a);
        transition: transform 0.2s ease;
    }

    .mega-tile:hover {
        transform: translateY(-2px);
    }

    .mega-tile__img {
        transition: transform 0.4s ease;
    }

    .mega-tile:hover .mega-tile__img {
        transform: scale(1.05);
    }

    .mega-tile__placeholder {
        width: 100%;
        height: 100%;
    }

    .mega-tile__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 60%);
        pointer-events: none;
    }

    .mega-tile__heading {
        font-weight: 600;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }
{% endstylesheet %}
