{% doc %}
  Renders one shoppable lookbook hotspot (pin button + optional product popover).

  @param {object} section - Parent section.
  @param {object} block - Hotspot block.
  @param {object} forloop - Parent `forloop` object (for numbered pins and index).
  @param {boolean} show_popover - When false (split + slider), only the pin is rendered; carousel sync handles the product.
  @param {number} hotspot_index - 0-based index for Splide sync and product card animation delay.
{% enddoc %}
{% liquid
  assign product = block.settings.product
  assign pin_style = section.settings.pin_style_default
  if block.settings.pin_style_override
    assign pin_style = block.settings.pin_style
  endif
  assign a11y_label = block.settings.label
  if a11y_label == blank and product != blank
    assign a11y_label = 'sections.lookbook.view_product' | t: title: product.title
  elsif a11y_label == blank
    assign a11y_label = 'sections.lookbook.view_product' | t: title: 'Product'
  endif
  assign splide_id = 'lookbook-splide-' | append: section.id
%}
<button
  type="button"
  class="lookbook-pin {% if pin_style == 'number' %}lookbook-pin--number{% endif %} {% if section.settings.pin_animation == 'pulse' %}is-pulse{% endif %} {% if block.settings.highlight %}is-highlight{% endif %}"
  data-lookbook-pin
  data-lookbook-block="{{ block.id }}"
  {% if show_popover %}
    aria-controls="LookbookPopover-{{ section.id }}-{{ block.id }}"
    aria-expanded="false"
  {% else %}
    aria-controls="{{ splide_id }}"
    aria-pressed="false"
    data-lookbook-slide-index="{{ hotspot_index }}"
  {% endif %}
  style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%;"
  {{ block.shopify_attributes }}
>
  <span class="lookbook-pin__inner lookbook-pin__inner--{{ pin_style }}" aria-hidden="true">
    {% if pin_style == 'plus' %}
      <span class="lookbook-pin__plus" aria-hidden="true"></span>
    {% elsif pin_style == 'number' %}
      <span class="lookbook-pin__number" aria-hidden="true">
        {% if block.settings.label != blank %}
          {{ block.settings.label }}
        {% else %}
          {{ forloop.index }}
        {% endif %}
      </span>
    {% endif %}
  </span>
  <span class="visually-hidden">{{ a11y_label }}</span>
</button>

{% if show_popover %}
  <div
    id="LookbookPopover-{{ section.id }}-{{ block.id }}"
    class="lookbook-popover lookbook-popover--{{ section.settings.card_style }}"
    data-lookbook-popover
    data-lookbook-block="{{ block.id }}"
    data-lookbook-align="{{ block.settings.desktop_align }}"
    style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%;"
    role="dialog"
    aria-label="{{ a11y_label }}"
    hidden
  >
    <div class="lookbook-popover__card">
      <button type="button" class="lookbook-popover__close" data-lookbook-close>
        <span class="lookbook-popover__close-icon" aria-hidden="true"></span>
        <span class="visually-hidden">{{ 'sections.lookbook.close' | t }}</span>
      </button>

      <div class="lookbook-popover__content">
        {% if product == blank %}
          <div class="lookbook-popover__empty">
            <p class="m-0 text-body-secondary">{{ 'sections.lookbook.missing_product' | t }}</p>
          </div>
        {% else %}
          <div class="lookbook-popover__product">
            {% render 'product-card',
              product: product,
              section: section,
              index: hotspot_index,
              sizes: '(min-width: 768px) 22rem, 92vw'
            %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}
