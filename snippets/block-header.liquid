{% doc %}
  Renders subheading, heading, description, and CTA buttons for banner-style blocks.

  @param {object} block - Block with content and typography settings.
  @param {object} section - Parent section (animation settings).
  @param {string} [alignment] - Extra alignment classes for the wrapper.
  @param {string} [additional_classes] - Optional extra classes on the wrapper.
  @param {boolean} [use_custom_colors] - When true, styles subheading with block accent colors.
  @param {string} [header_animation] - When set (e.g. video blocks), overrides section animation.
  @param {string} [header_animation_speed] - When set, overrides section animation speed.
{% enddoc %}

{% liquid
  assign sub_m = block.settings.subheader_font_size_mobile | default: block.settings.mobile_subheading_font_size | default: 4
  assign subheader_fs_mobile = sub_m | prepend: 'fs-'
  assign sub_d = block.settings.subheader_font_size_desktop | default: block.settings.desktop_subheading_font_size | default: 6
  assign subheader_fs_desktop = sub_d | prepend: 'fs-lg-'
  assign t_m = block.settings.title_font_size_mobile | default: block.settings.mobile_heading_font_size | default: section.settings.title_font_size_mobile | default: 8
  assign title_fs_mobile = t_m | prepend: 'fs-'
  assign t_d = block.settings.title_font_size_desktop | default: block.settings.desktop_heading_font_size | default: section.settings.title_font_size_desktop | default: 10
  assign title_fs_desktop = t_d | prepend: 'fs-lg-'
  assign d_m = block.settings.description_font_size_mobile | default: block.settings.mobile_paragraph_font_size | default: section.settings.description_font_size_mobile | default: 5
  assign desc_fs_mobile = d_m | prepend: 'fs-'
  assign d_d = block.settings.description_font_size_desktop | default: block.settings.desktop_paragraph_font_size | default: section.settings.description_font_size_desktop | default: 8
  assign desc_fs_desktop = d_d | prepend: 'fs-lg-'
  assign title = block.settings.title
  assign subheader = block.settings.subheader | strip
  assign description = block.settings.description
  if header_animation != nil
    assign animation = header_animation
  else
    assign animation = section.settings.animation
  endif
  if header_animation_speed != nil
    assign animation_speed = header_animation_speed
  else
    assign animation_speed = section.settings.animation_speed
  endif
  assign p-btn-text = block.settings.p-btn-text
  assign p-btn-type = block.settings.p-btn-type
  assign p-btn-url = block.settings.p-btn-url
  assign s-btn-text = block.settings.s-btn-text
  assign s-btn-type = block.settings.s-btn-type
  assign s-btn-url = block.settings.s-btn-url


%}
<div class="block-header d-flex flex-column gap-4 {{ additional_classes }} {{ alignment }}">
  {% unless subheader == blank %}
    <h4
      class="
        mb-4 fit-content {% if use_custom_colors %}rounded p-4{% endif %}
        {{ subheader_fs_mobile }} {{ subheader_fs_desktop }} text-uppercase {% unless animation == '' %}animate__animated opacity-0 {{ animation_speed }}{% endunless %}
      "
      data-animate-class="{{ animation }}"
      style="animation-delay: 150ms;{% if use_custom_colors %} background-color: {{ block.settings.subheading_background }}; color: {{ block.settings.subheading_color }}{% endif %}"
    >
      {{- subheader -}}
    </h4>
  {% endunless %}
  {% unless title == blank %}
    <h2
      class="mb-5 {{ title_fs_mobile }} {{ title_fs_desktop }} {% unless animation == '' %}animate__animated opacity-0 {{ animation_speed }}{% endunless %}"
      data-animate-class="{{ animation }}"
      style="animation-delay: 250ms;"
    >
      {{ title }}
    </h2>
  {% endunless %}
  {% unless description == blank %}
    <div
      class="block-header__description rte mt-n4 mb-5 {{ desc_fs_mobile }} {{ desc_fs_desktop }} {% unless animation == '' %}animate__animated opacity-0 {{ animation_speed }}{% endunless %}"
      data-animate-class="{{ animation }}"
      style="animation-delay: 350ms;"
    >
      {{ description }}
    </div>
  {% endunless %}
  <div class="btn-wrapper d-flex gap-6">
  {% unless p-btn-text == blank %}
    <a href="{{ p-btn-url }}" class="btn rounded {{ p-btn-type }} {% unless animation == '' %}animate__animated opacity-0 {{ animation_speed }}{% endunless %}"
    data-animate-class="{{ animation }}" style="animation-delay: 450ms;">
      {{ p-btn-text }}
    </a>
  {% endunless %}  

  {% unless s-btn-text == blank %}
    <a href="{{ s-btn-url }}" class="btn rounded {{ s-btn-type }} {% unless animation == '' %}animate__animated opacity-0 {{ animation_speed }}{% endunless %}"
    data-animate-class="{{ animation }}" style="animation-delay: 550ms;">
      {{ s-btn-text }}
    </a>
  {% endunless %}
  </div>

</div>
