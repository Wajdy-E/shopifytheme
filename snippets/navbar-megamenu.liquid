{% doc %}
    Renders the desktop navigation list. Every top-level link with children
    is dispatched to the chosen mega menu style snippet:

    - mega-columns       → 'navbar-mega-columns'
    - mega-with-promos   → 'navbar-mega-promos'
    - mega-image-tiles   → 'navbar-mega-tiles'

    Top-level links with no children render as a plain nav-item. A link
    titled '|' acts as a separator: every link after it is consumed by
    the icon cluster (snippets/navbar-desktop-icons.liquid) and is
    skipped here.

    @param {object} section - The parent section object (passed from sections/navbar.liquid).
{% enddoc %}

{%- liquid
    assign menu_links = linklists[section.settings.menu_desktop].links
    assign mega_style = section.settings.mega_menu_style | default: 'mega-with-promos'
    assign menu_index = 0
    assign font_classes = section.settings.menu_desktop_font_family | append: ' fs-' | append: section.settings.menu_desktop_font_size
-%}

<ul class="nav nav-links justify-content-center">
    {%- for link in menu_links -%}
        {%- if link.title == '|' -%}
            {%- break -%}
        {%- endif -%}

        {%- assign menu_index = menu_index | plus: 1 -%}

        {%- if link.links == blank -%}
            <li class="nav-item">
                <a
                    class="nav-link rounded {{ font_classes }} {% if link.active %}active{% endif %}"
                    href="{{ link.url }}"
                    aria-current="{% if link.active %}page{% endif %}"
                >
                    {{ link.title }}
                </a>
            </li>
        {%- else -%}
            <li class="nav-item dropdown nav-mega position-static">
                <a
                    class="nav-link rounded dropdown-toggle {{ font_classes }} {% if link.child_active %}active{% endif %}"
                    href="{{ link.url | default: '#' }}"
                    {% if section.settings.menu_desktop_trigger != 'menu-desktop-hover' %}
                        data-bs-toggle="dropdown"
                        data-bs-display="static"
                    {% endif %}
                    aria-expanded="false"
                    data-index="{{ menu_index }}"
                    role="button"
                >
                    {{ link.title }}
                </a>
                <div class="dropdown-megamenu dropdown-menu">
                    <div class="{{ section.settings.container }}">
                        {%- case mega_style -%}
                            {%- when 'mega-columns' -%}
                                {%- render 'navbar-mega-columns', section: section, link: link, parent_position: menu_index -%}
                            {%- when 'mega-image-tiles' -%}
                                {%- render 'navbar-mega-tiles', section: section, link: link, parent_position: menu_index -%}
                            {%- else -%}
                                {%- render 'navbar-mega-promos', section: section, link: link, parent_position: menu_index -%}
                        {%- endcase -%}
                    </div>
                </div>
            </li>
        {%- endif -%}
    {%- endfor -%}
</ul>

{% stylesheet %}
    .navbar {
        position: relative;
    }

    .dropdown-megamenu.dropdown-menu {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        width: 100%;
        margin: 0;
        border-radius: 0;
        border-left: 0;
        border-right: 0;
        padding: 1.5rem 0;
    }

    /* Invisible bridge between the trigger and the panel so the
       cursor never falls into a 1px gap. */
    .menu-desktop-hover .nav-mega.dropdown > .dropdown-megamenu.dropdown-menu::before {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        top: -12px;
        height: 12px;
        background: transparent;
    }

    /* Open state is driven by JS (.is-mega-open) plus :focus-within
       for keyboard accessibility. CSS :hover is intentionally NOT used
       so we can't end up with a stuck/half-open state across pointer
       transitions. */
    .menu-desktop-hover .nav-mega.dropdown.is-mega-open > .dropdown-megamenu.dropdown-menu,
    .menu-desktop-hover .nav-mega.dropdown:focus-within > .dropdown-megamenu.dropdown-menu {
        display: block !important;
    }
{% endstylesheet %}

<script>
    (function () {
        if (window.__navMegaHoverInit) {
            return;
        }
        window.__navMegaHoverInit = true;

        var LEAVE_DELAY = 150;

        function init() {
            var navs = document.querySelectorAll('.menu-desktop-hover');
            if (navs.length === 0) {
                return;
            }

            navs.forEach(function (nav) {
                var items = nav.querySelectorAll('.nav-mega.dropdown');

                items.forEach(function (item) {
                    var timer;

                    function open() {
                        clearTimeout(timer);
                        items.forEach(function (other) {
                            if (other !== item) {
                                other.classList.remove('is-mega-open');
                            }
                        });
                        item.classList.add('is-mega-open');
                    }

                    function scheduleClose() {
                        clearTimeout(timer);
                        timer = setTimeout(function () {
                            item.classList.remove('is-mega-open');
                        }, LEAVE_DELAY);
                    }

                    item.addEventListener('mouseenter', open);
                    item.addEventListener('mouseleave', scheduleClose);
                    item.addEventListener('focusin', open);
                    item.addEventListener('focusout', function (event) {
                        if (!item.contains(event.relatedTarget)) {
                            scheduleClose();
                        }
                    });
                });
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
</script>
