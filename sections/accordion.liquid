{% liquid
  assign pt = section.settings.pt | prepend: 'pt-'
  assign pb = section.settings.pb | prepend: 'pb-'
  assign mt = section.settings.mt | prepend: 'mt-'
  assign mb = section.settings.mb | prepend: 'mb-'

  assign color_scheme_class = 'color-' | append: section.settings.color_scheme

  assign header_layout = section.settings.header_position | default: 'top'
  assign accordion_pad = 'px-sm-7 px-0'
  if header_layout != 'top'
    assign accordion_pad = ''
  endif
  assign accordion_wrap_class = accordion_pad
  unless section.settings.animation == ''
    assign accordion_wrap_class = accordion_wrap_class | append: ' animate__animated opacity-0 ' | append: section.settings.animation_speed
  endunless

  if section.settings.visibility == blank or section.settings.visibility == nil
    assign visibility_class = 'd-flex'
  else
    assign visibility_class = section.settings.visibility
  endif
%}
<section
  id="accordion-{{ section.id }}"
  class="enter-view {{ visibility_class }} {{ pt }} {{ pb }} {{ mt }} {{ mb }} {{ color_scheme_class }}{% if header_layout == 'top' %} {{ section.settings.text_align }}{% endif %}"
>
  <div class="{{ section.settings.container }}">
    {% case header_layout %}
      {% when 'top' %}
        <div
          class="{{ accordion_wrap_class }}"
          data-animate-class="{{ section.settings.animation }}"
          style="animation-delay:150ms;"
        >
          {% render 'section-header', section: section %}
          {% render 'accordion-section-body', section: section %}
        </div>

      {% when 'left' %}
        <div class="row align-items-lg-start gx-sm-7 px-sm-7 px-0 gy-5 gy-lg-4">
          <div class="col-12 col-lg-5 accordion-section__header-col {{ section.settings.text_align }}">
            {% render 'section-header', section: section %}
          </div>
          <div class="col-12 col-lg-7">
            <div
              class="{{ accordion_wrap_class }}"
              data-animate-class="{{ section.settings.animation }}"
              style="animation-delay:150ms;"
            >
              {% render 'accordion-section-body', section: section %}
            </div>
          </div>
        </div>

      {% when 'right' %}
        <div class="row align-items-lg-start gx-sm-7 px-sm-7 px-0 gy-5 gy-lg-4">
          <div class="col-12 col-lg-7 order-1 order-lg-1">
            <div
              class="{{ accordion_wrap_class }}"
              data-animate-class="{{ section.settings.animation }}"
              style="animation-delay:150ms;"
            >
              {% render 'accordion-section-body', section: section %}
            </div>
          </div>
          <div class="col-12 col-lg-5 order-2 order-lg-2 accordion-section__header-col {{ section.settings.text_align }}">
            {% render 'section-header', section: section %}
          </div>
        </div>
    {% endcase %}
  </div>
</section>

