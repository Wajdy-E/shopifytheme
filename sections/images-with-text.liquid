{% liquid
  assign color_scheme_class = 'color-' | append: section.settings.color_scheme
  assign layout_overlay = false
  if section.settings.content_layout == 'overlay'
    assign layout_overlay = true
  endif

  assign pt = section.settings.pt | prepend: 'pt-'
  assign pb = section.settings.pb | prepend: 'pb-'
  assign mt = section.settings.mt | prepend: 'mt-'
  assign mb = section.settings.mb | prepend: 'mb-'

  if layout_overlay
    assign row_sm = section.settings.grid_cols_sm | prepend: 'row-cols-'
    assign row_lg = section.settings.grid_cols_lg | prepend: 'row-cols-lg-'
    assign banner_height = section.settings.desktop_banner_height | append: ' ' | append: section.settings.mobile_banner_height
  else
    assign row_sm = section.settings.breakpoint_sm | prepend: 'row-cols-'
    assign row_lg = section.settings.breakpoint_lg | prepend: 'row-cols-lg-'
    if section.settings.scroll
      assign row_sm = row_sm | append: '-5'
    endif
    assign mobile_scroll = ''
    if section.settings.scroll
      assign mobile_scroll = 'mobile_scroll'
    endif
  endif
%}

<section
  id="images-with-text-{{ section.id }}"
  class="
    {% if layout_overlay %}image-banner {% else %}overflow-hidden {% endif %}enter-view
    {% if layout_overlay %}{{ pt }} {{ pb }} {{ mt }} {{ mb }}{% endif %}
    {% if layout_overlay %}
      {% if section.settings.visibility == 'd-block' %}d-flex {% else %}{% if section.settings.visibility == blank or section.settings.visibility == nil %}d-flex{% else %}{{ section.settings.visibility }}{% endif %}{% endif %}
    {% else %}
      {% if section.settings.visibility == blank or section.settings.visibility == nil %}d-flex{% else %}{{ section.settings.visibility }}{% endif %}
    {% endif %}
    {% if layout_overlay %}{% else %}justify-content-center {{ section.settings.text_alignment }}{% endif %}
    {% if layout_overlay %}{% else %}pt-{{ section.settings.pt }} pb-{{ section.settings.pb }} mt-{{ section.settings.mt }} mb-{{ section.settings.mb }}{% endif %}
    {{ color_scheme_class }}
    {% if customer and section.settings.showTo == 'guest' %}d-none{% elsif section.settings.showTo == 'customer' %}{% unless customer %}d-none{% endunless %}{% endif %}
  "
  {% unless layout_overlay %}style="background-color: {{ section.settings.bg_color }};"{% endunless %}
>
  {% if layout_overlay %}
    <div class="{{ section.settings.container }}">
      <div class="row {{ row_sm }} {{ row_lg }} g-8">
        {% for block in section.blocks %}
          {% liquid
            assign alignment = block.settings.mobile_text_alignment | append: ' ' | append: block.settings.desktop_text_alignment
            assign block_anim = block.settings.animation
            assign block_anim_sp = block.settings.animation_speed
            if forloop.first and section.index == 1
              assign loading = 'eager'
              assign fetchpriority = 'high'
            else
              assign loading = 'lazy'
              assign fetchpriority = 'low'
            endif
          %}
          <div class="grid-item col {{ banner_height }}" {{ block.shopify_attributes }}>
            <div class="position-relative overflow-hidden w-100 has-image p-0 round">
              {% case block.type %}
                {% when 'image' %}
                  <picture class="zoom-on-hover">
                    <source
                      media="(max-width: 768px)"
                      srcset="{% if block.settings.mobile_image %}{{ block.settings.mobile_image | image_url: width: 375 }} 375w, {{ block.settings.mobile_image | image_url: width: 690 }} 690w{% endif %}"
                      sizes="(max-width: 768px) 375px, 690px"
                      width="{{ block.settings.mobile_image.width }}"
                      height="{{ block.settings.mobile_image.height }}"
                    >
                    {% if block.settings.desktop_image %}
                      <img
                        src="{{ block.settings.desktop_image | image_url: width: block.settings.desktop_image.width }}"
                        data-srcset="{{ block.settings.desktop_image | image_url: width: 375 }} 375w, {{ block.settings.desktop_image | image_url: width: 690 }} 690w, {{ block.settings.desktop_image | image_url: width: 1380 }} 1380w"
                        sizes="(max-width: 768px) 375px, 690px"
                        width="{{ block.settings.desktop_image.width }}"
                        height="{{ block.settings.desktop_image.height }}"
                        alt="{{ block.settings.desktop_image.alt | escape }}"
                        class="{{ section.settings.desktop_banner_height }} {{ section.settings.mobile_banner_height }} d-block w-100 object-fit-cover zoom-on-hover"
                        loading="{{ loading }}"
                        fetchpriority="{{ fetchpriority }}"
                      >
                    {% else %}
                      {{ 'hero-apparel-1' | placeholder_svg_tag: banner_height }}
                    {% endif %}
                  </picture>
                  <div
                    class="overlay"
                    style="--overlay-color: {{ block.settings.overlay_color }}; --overlay-opacity: {{ block.settings.overlay_opacity }};"
                  ></div>
                  <div
                    class="p-5 position-absolute z-2 h-fit {{ block.settings.desktop_content_position }} d-flex {{ block.settings.desktop_text_alignment }}
                      {{ block.settings.mobile_content_position }} w-100"
                  >
                    {% render 'block-header', block: block, section: section, alignment: alignment, header_animation: block_anim, header_animation_speed: block_anim_sp %}
                  </div>
                {% when 'text' %}
                  {% liquid
                    assign o_desktop = block.settings.desktop_image
                    if o_desktop == blank
                      assign o_desktop = block.settings.image
                    endif
                    assign o_mobile = block.settings.mobile_image
                    if o_mobile == blank
                      assign o_mobile = o_desktop
                    endif
                  %}
                  {% if o_desktop != blank %}
                    <picture class="zoom-on-hover">
                      <source
                        media="(max-width: 768px)"
                        srcset="{% if o_mobile %}{{ o_mobile | image_url: width: 375 }} 375w, {{ o_mobile | image_url: width: 690 }} 690w{% endif %}"
                        sizes="(max-width: 768px) 375px, 690px"
                        width="{{ o_mobile.width }}"
                        height="{{ o_mobile.height }}"
                      >
                      <img
                        src="{{ o_desktop | image_url: width: o_desktop.width }}"
                        data-srcset="{{ o_desktop | image_url: width: 375 }} 375w, {{ o_desktop | image_url: width: 690 }} 690w, {{ o_desktop | image_url: width: 1380 }} 1380w"
                        sizes="(max-width: 768px) 375px, 690px"
                        width="{{ o_desktop.width }}"
                        height="{{ o_desktop.height }}"
                        alt="{{ o_desktop.alt | escape }}"
                        class="{{ section.settings.desktop_banner_height }} {{ section.settings.mobile_banner_height }} d-block w-100 object-fit-cover zoom-on-hover"
                        loading="{{ loading }}"
                        fetchpriority="{{ fetchpriority }}"
                      >
                    </picture>
                  {% else %}
                    {{ 'hero-apparel-1' | placeholder_svg_tag: banner_height }}
                  {% endif %}
                  <div
                    class="overlay"
                    style="--overlay-color: {{ block.settings.overlay_color }}; --overlay-opacity: {{ block.settings.overlay_opacity }};"
                  ></div>
                  <div
                    class="p-5 position-absolute z-2 h-fit {{ block.settings.desktop_content_position }} d-flex {{ block.settings.desktop_text_alignment }}
                      {{ block.settings.mobile_content_position }} w-100"
                  >
                    {% render 'block-header', block: block, section: section, alignment: alignment, header_animation: block_anim, header_animation_speed: block_anim_sp %}
                  </div>
                {% when 'video' %}
                  {% if block.settings.carousel_video_upload != blank %}
                    {% assign video_url = block.settings.poster | image_url: width: 500 %}
                    {% assign video_classes = 'w-100 object-fit-cover h-100  ' | append: banner_height %}
                    {{
                      block.settings.carousel_video_upload
                      | video_tag:
                        playsinline: true,
                        muted: true,
                        autoplay: true,
                        loop: true,
                        controls: false,
                        preload: 'none',
                        poster: video_url,
                        class: video_classes,
                        loading: loading,
                        fetchpriority: fetchpriority
                    }}
                  {% elsif block.settings.carousel_video_url != blank %}
                    <div class="position-relative w-100 overflow-hidden {{ section.settings.desktop_banner_height }} {{ section.settings.mobile_banner_height }}">
                      {% if block.settings.carousel_video_url.type == 'youtube' %}
                        <iframe
                          class="position-absolute top-0 start-0 w-100 h-100 border-0"
                          src="https://www.youtube.com/embed/{{ block.settings.carousel_video_url.id }}?autoplay=1&mute=1&playsinline=1&loop=1&playlist={{ block.settings.carousel_video_url.id }}&controls=0"
                          allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
                          title="{{ block.settings.title | default: 'Video' | escape }}"
                          loading="{{ loading }}"
                        ></iframe>
                      {% elsif block.settings.carousel_video_url.type == 'vimeo' %}
                        <iframe
                          class="position-absolute top-0 start-0 w-100 h-100 border-0"
                          src="https://player.vimeo.com/video/{{ block.settings.carousel_video_url.id }}?autoplay=1&muted=1&loop=1&background=1"
                          allow="autoplay; encrypted-media; fullscreen"
                          title="{{ block.settings.title | default: 'Video' | escape }}"
                          loading="{{ loading }}"
                        ></iframe>
                      {% endif %}
                    </div>
                  {% else %}
                    {{ 'lifestyle-1' | placeholder_svg_tag: banner_height }}
                  {% endif %}
                  <div
                    class="overlay"
                    style="--overlay-color: {{ block.settings.overlay_color }}; --overlay-opacity: {{ block.settings.overlay_opacity }};"
                  ></div>
                  <div
                    class="banner-content position-absolute z-2 h-fit {{ block.settings.desktop_content_position }} {{ block.settings.mobile_content_position }} d-flex {{ block.settings.desktop_text_alignment }} w-100"
                  >
                    {% render 'block-header', block: block, section: section, alignment: alignment, header_animation: block_anim, header_animation_speed: block_anim_sp %}
                  </div>
                {% else %}
                  {{ 'lifestyle-1' | placeholder_svg_tag: banner_height }}
              {% endcase %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="{{ section.settings.container }}">
      <ul class="list-unstyled row {{ section.settings.text_alignment }} {{ mobile_scroll }} {{ row_sm }} {{ row_lg }} g-8">
        {% for block in section.blocks %}
          {% liquid
            assign apparel_number = forloop.index | modulo: 3 | plus: 1
            assign stacked_img = block.settings.image
            if block.type == 'image' and block.settings.desktop_image != blank
              assign stacked_img = block.settings.desktop_image
            endif
            assign block_anim = block.settings.animation
            assign block_anim_sp = block.settings.animation_speed
          %}
          <li
            class="col {% unless section.settings.animation == '' %}animate__animated opacity-0 {{ section.settings.animation_speed }}{% endunless %}"
            style="animation-delay: {{ forloop.index0 | times: 150 }}ms;{% if block.settings.block_bg_color != blank or block.settings.text_color != blank %} background-color: {{ block.settings.block_bg_color }}; color: {{ block.settings.text_color }};{% endif %}"
            data-animate-class="{{ section.settings.animation }}"
            {{ block.shopify_attributes }}
          >
            {% case block.type %}
              {% when 'video' %}
                <div class="d-flex flex-column block rounded has-image p-0 overflow-hidden">
                  {% if block.settings.carousel_video_upload != blank %}
                    {% assign video_url = block.settings.poster | image_url: width: 500 %}
                    {{
                      block.settings.carousel_video_upload
                      | video_tag:
                        playsinline: true,
                        muted: true,
                        autoplay: true,
                        loop: true,
                        controls: false,
                        preload: 'none',
                        poster: video_url,
                        class: 'img-fluid w-100',
                        loading: 'lazy'
                    }}
                  {% elsif block.settings.carousel_video_url != blank %}
                    <div class="ratio ratio-16x9 w-100 bg-dark">
                      {% if block.settings.carousel_video_url.type == 'youtube' %}
                        <iframe
                          class="position-absolute top-0 start-0 w-100 h-100 border-0"
                          src="https://www.youtube.com/embed/{{ block.settings.carousel_video_url.id }}?autoplay=1&mute=1&playsinline=1&loop=1&playlist={{ block.settings.carousel_video_url.id }}&controls=0"
                          allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
                          title="{{ block.settings.title | default: 'Video' | escape }}"
                          loading="lazy"
                        ></iframe>
                      {% elsif block.settings.carousel_video_url.type == 'vimeo' %}
                        <iframe
                          class="position-absolute top-0 start-0 w-100 h-100 border-0"
                          src="https://player.vimeo.com/video/{{ block.settings.carousel_video_url.id }}?autoplay=1&muted=1&loop=1&background=1"
                          allow="autoplay; encrypted-media; fullscreen"
                          title="{{ block.settings.title | default: 'Video' | escape }}"
                          loading="lazy"
                        ></iframe>
                      {% endif %}
                    </div>
                  {% endif %}
                  <div class="content p-6">
                    {% render 'block-header', block: block, section: section, alignment: section.settings.text_alignment, header_animation: block_anim, header_animation_speed: block_anim_sp %}
                  </div>
                </div>
              {% else %}
                <div class="d-flex {{ section.settings.image_position }} block rounded has-image p-0">
                  {% if stacked_img == blank %}
                    {{ 'hero-apparel-' | append: apparel_number | placeholder_svg_tag }}
                  {% else %}
                    <img
                      src="{{ stacked_img | image_url: width: 1500 }}"
                      alt="{{ stacked_img.alt | escape }}"
                      width="{{ stacked_img.width }}"
                      height="{{ stacked_img.height }}"
                      class="img-fluid"
                      loading="lazy"
                    >
                  {% endif %}
                  <div class="content p-6">
                    {% render 'block-header', block: block, section: section, alignment: section.settings.text_alignment, header_animation: block_anim, header_animation_speed: block_anim_sp %}
                  </div>
                </div>
            {% endcase %}
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Images with text",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_layout",
      "label": "Display",
      "default": "stacked",
      "info": "Stacked = original Images with text. Overlay / banner = full-width media (image, video, or YouTube/Vimeo) with text and buttons on top—same behavior as the old Image banner section.",
      "options": [
        { "value": "stacked", "label": "Stacked cards (image + text)" },
        { "value": "overlay", "label": "Banner overlay (media + text on top)" }
      ]
    },
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Visible on",
      "default": "d-flex",
      "options": [
        { "value": "d-flex", "label": "All screen sizes" },
        { "value": "d-sm-none d-lg-flex", "label": "On desktop only" },
        { "value": "d-lg-none d-sm-flex", "label": "On mobile only" }
      ]
    },
    {
      "type": "select",
      "id": "showTo",
      "label": "Visible to",
      "default": "everyone",
      "info": "If you're not logged in within the customizer and you've chosen display to customers, it will not show within customizer.",
      "options": [
        { "label": "Logged in", "value": "customer" },
        { "label": "Guests only", "value": "guest" },
        { "label": "Everyone", "value": "everyone" }
      ]
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Full width" },
        { "value": "container-fluid no-gap", "label": "Full width (no gap)" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "info": "Stacked layout only (optional)"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "animate__fadeInUp",
      "options": [
        { "group": "Disabled", "value": "", "label": "No animation" },
        { "group": "Fade", "value": "animate__fadeIn", "label": "Fade In" },
        { "group": "Fade", "value": "animate__fadeInDown", "label": "Fade-in-down" },
        { "group": "Fade", "value": "animate__fadeInLeft", "label": "Fade-in-left" },
        { "group": "Fade", "value": "animate__fadeInRight", "label": "Fade-in-right" },
        { "group": "Fade", "value": "animate__fadeInUp", "label": "Fade-in-up" },
        { "group": "Zoom", "value": "animate__zoomIn", "label": "Zoom-in" },
        { "group": "Zoom", "value": "animate__zoomInDown", "label": "Zoom-in-down" },
        { "group": "Zoom", "value": "animate__zoomInLeft", "label": "Zoom-in-left" },
        { "group": "Zoom", "value": "animate__zoomInRight", "label": "Zoom-in-right" },
        { "group": "Zoom", "value": "animate__zoomInUp", "label": "Zoom-in-up" },
        { "group": "Back", "value": "animate__backInDown", "label": "Back-in-down" },
        { "group": "Back", "value": "animate__backInLeft", "label": "Back-in-left" },
        { "group": "Back", "value": "animate__backInRight", "label": "Back-in-right" },
        { "group": "Back", "value": "animate__backInUp", "label": "Back-in-up" },
        { "group": "Bounce", "value": "animate__bounceIn", "label": "Bounce-in" },
        { "group": "Bounce", "value": "animate__bounceInDown", "label": "Bounce-in-down" },
        { "group": "Bounce", "value": "animate__bounceInLeft", "label": "Bounce-in-left" },
        { "group": "Bounce", "value": "animate__bounceInRight", "label": "Bounce-in-right" },
        { "group": "Bounce", "value": "animate__bounceInUp", "label": "Bounce-in-up" },
        { "group": "LightSpeed", "value": "animate__lightSpeedInLeft", "label": "LightSpeed-in-left" },
        { "group": "LightSpeed", "value": "animate__lightSpeedInRight", "label": "LightSpeed-in-right" }
      ]
    },
    {
      "type": "select",
      "id": "animation_speed",
      "label": "Animation speed",
      "default": "animate__fast",
      "options": [
        { "value": "animate__slower", "label": "Slower" },
        { "value": "animate__slow", "label": "Slow" },
        { "value": "", "label": "Normal" },
        { "value": "animate__fast", "label": "Fast" },
        { "value": "animate__faster", "label": "Faster" }
      ]
    },
    {
      "type": "header",
      "content": "Font Sizes",
      "info": "Section defaults from Images with text: used when a block does not set its own sizes (after block-specific fallbacks)."
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "Title font-size | mobile",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "title_font_size_desktop",
      "label": "Title font-size | desktop",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 7
    },
    {
      "type": "range",
      "id": "description_font_size_mobile",
      "label": "Description font-size | mobile",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "description_font_size_desktop",
      "label": "Description font-size | desktop",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Stacked layout",
      "info": "From Images with text. Applies when Layout is Stacked."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "label": "Top", "value": "flex-column" },
        { "label": "Bottom", "value": "flex-column-reverse" },
        { "label": "Left", "value": "flex-row" },
        { "label": "Right", "value": "flex-row-reverse" }
      ],
      "default": "flex-column"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "label": "Left", "value": "text-start" },
        { "label": "Center", "value": "text-center" }
      ],
      "default": "text-start"
    },
    {
      "type": "checkbox",
      "id": "scroll",
      "label": "Scroll on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "breakpoint_sm",
      "label": "Items per row / sm",
      "info": "Screen width: ≥576px",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "breakpoint_lg",
      "label": "Items per row / lg",
      "info": "Screen width: ≥992px",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Banner overlay",
      "info": "Used when Display is Banner overlay. Same settings as the old Image banner (heights, columns per row)."
    },
    {
      "type": "select",
      "id": "desktop_banner_height",
      "label": "Desktop image height",
      "options": [
        { "label": "400px", "value": "h-d-400" },
        { "label": "500px", "value": "h-d-500" },
        { "label": "600px", "value": "h-d-600" },
        { "label": "700px", "value": "h-d-700" },
        { "label": "800px", "value": "h-d-800" },
        { "label": "Full screen", "value": "h-d-full" },
        { "label": "Adapt to first image", "value": "h-d-auto" }
      ],
      "default": "h-d-600"
    },
    {
      "type": "select",
      "id": "mobile_banner_height",
      "label": "Mobile image height",
      "options": [
        { "label": "400px", "value": "h-m-400" },
        { "label": "500px", "value": "h-m-500" },
        { "label": "600px", "value": "h-m-600" },
        { "label": "700px", "value": "h-m-700" },
        { "label": "800px", "value": "h-m-800" },
        { "label": "Full screen", "value": "h-m-full" },
        { "label": "Adapt to first image", "value": "h-m-auto" }
      ],
      "default": "h-m-400"
    },
    {
      "type": "range",
      "id": "grid_cols_sm",
      "label": "Banners/row (Mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "grid_cols_lg",
      "label": "Banners/row (Desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Padding Top",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Padding Bottom",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "mt",
      "label": "Margin Top",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "mb",
      "label": "Margin Bottom",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Image with text",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Stacked layout, or overlay fallback if desktop image is empty"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image",
          "info": "Overlay layout (optional if Image is set)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Overlay layout (optional)"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "subheader",
          "label": "Subheading",
