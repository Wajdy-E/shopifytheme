{% liquid
    assign pt = section.settings.pt | prepend: 'pt-'
    assign pb = section.settings.pb | prepend: 'pb-'

    assign bg_color = section.settings.bg_color

    if section.settings.bg_gradient
        assign bg_color = bg_color | append: ' bg-gradient'
    endif

    if section.settings.bg_transparent and section.settings.bg_transparent_hover and request.page_type == 'index'
        assign bg_color = bg_color | append: ' navbar-hover navbar-transparent text-white'
    elsif section.settings.bg_transparent and request.page_type == 'index'
        assign bg_color = bg_color | append: ' navbar-transparent text-white'
    endif

    if section.settings.always_show_toggle
        assign navbar_mobile_classes = ''
        assign navbar_desktop_classes = 'd-none'
    else
        assign navbar_mobile_classes = 'd-lg-none'
        assign navbar_desktop_classes = 'd-none d-lg-block'
    endif

    assign navbar_blur_class = ''
    if section.settings.bg_blur
        assign navbar_blur_class = 'navbar-bg-blur'
    endif

    assign navbar_shared_classes = bg_color | append: ' ' | append: section.settings.shadow | append: ' ' | append: navbar_blur_class | append: ' ' | append: pt | append: ' ' | append: pb
%}

{%- case section.settings.layout_mobile -%}
    {%- when 'navbar-mobile-bottom-bar' -%}
        {%- render 'navbar-mobile-bottom-bar',
            section: section,
            navbar_classes: navbar_shared_classes,
            navbar_visibility: navbar_mobile_classes
        -%}
    {%- when 'navbar-mobile-with-search' -%}
        {%- render 'navbar-mobile-search',
            section: section,
            navbar_classes: navbar_shared_classes,
            navbar_visibility: navbar_mobile_classes
        -%}
    {%- else -%}
        {%- render 'navbar-mobile-simple',
            section: section,
            navbar_classes: navbar_shared_classes,
            navbar_visibility: navbar_mobile_classes
        -%}
{%- endcase -%}

{%- case section.settings.layout_desktop -%}
    {%- when 'navbar-desktop-stacked' -%}
        {%- render 'navbar-desktop-stacked',
            section: section,
            navbar_classes: navbar_shared_classes,
            navbar_visibility: navbar_desktop_classes
        -%}
    {%- when 'navbar-desktop-logo-center' -%}
        {%- render 'navbar-desktop-split',
            section: section,
            navbar_classes: navbar_shared_classes,
            navbar_visibility: navbar_desktop_classes
        -%}
    {%- else -%}
        {%- render 'navbar-desktop-classic',
            section: section,
            navbar_classes: navbar_shared_classes,
            navbar_visibility: navbar_desktop_classes
        -%}
{%- endcase -%}

{% render 'offcanvas-menu' %}

<script type="application/ld+json">
    {
        "@context": "http://schema.org",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        {% if section.settings.logo %}
            "logo": {{ section.settings.logo | image_url: width: 500 | prepend: "https:" | json }},
        {% endif %}
        "sameAs": [
            {{ settings.social_facebook | json }},
            {{ settings.social_twitter | json }},
            {{ settings.social_instagram | json }},
            {{ settings.social_pinterest | json }},
            {{ settings.social_tiktok | json }},
            {{ settings.social_snapchat | json }},
            {{ settings.social_snapchat | json }},
            {{ settings.social_youtube | json }},
            {{ settings.social_linkedin | json }}
        ],
        "url": {{ request.origin | append: page.url | json }}
    }
</script>

{%- if request.page_type == 'index' -%}
    {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
    <script type="application/ld+json">
        {
            "@context": "http://schema.org",
            "@type": "WebSite",
            "name": {{ shop.name | json }},
            "potentialAction": {
                "@type": "SearchAction",
                "target": {{ potential_action_target | json }},
                "query-input": "required name=search_term_string"
            },
            "url": {{ request.origin | append: page.url | json }}
        }
    </script>
{%- endif -%}

{% schema %}
{
