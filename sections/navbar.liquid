                { "group": "Light", "value": "bg-white text-body", "label": "White" },
                { "group": "Light", "value": "bg-light text-body", "label": "Light" },
                { "group": "Dark", "value": "bg-primary text-white", "label": "Primary" },
                { "group": "Dark", "value": "bg-secondary text-white", "label": "Secondary" },
                { "group": "Dark", "value": "bg-dark text-white", "label": "Dark" },
                { "group": "Alert", "value": "bg-success text-white", "label": "Success" },
                { "group": "Alert", "value": "bg-warning text-white", "label": "Warning" },
                { "group": "Alert", "value": "bg-danger text-white", "label": "Danger" },
                { "group": "Alert", "value": "bg-info text-white", "label": "Info" }
            ]
        },
        {
            "type": "checkbox",
            "id": "bg_gradient",
            "label": "Background gradient",
            "default": false,
            "info": "Will not apply to light colors"
        },
        {
            "type": "checkbox",
            "id": "bg_transparent",
            "label": "Background transparent",
            "default": true,
            "info": "Applies only in the homepage."
        },
        {
            "type": "checkbox",
            "id": "bg_transparent_hover",
            "label": "Background transparent hover effect",
            "default": false,
            "info": "Applies only in the homepage. When hovering on transparent it will show"
        },
        {
            "type": "checkbox",
            "id": "bg_blur",
            "label": "Background blur effect",
            "default": true
        },
        {
            "type": "select",
            "id": "container",
            "label": "Container",
            "default": "container",
            "options": [
                { "value": "container", "label": "Container" },
                { "value": "container-fluid", "label": "Fluid" }
            ]
        },
        {
            "type": "select",
            "id": "shadow",
            "label": "Shadow",
            "options": [
                { "value": "shadow-none", "label": "No shadow" },
                { "value": "shadow-sm", "label": "Shadow sm" },
                { "value": "shadow", "label": "Shadow" },
                { "value": "shadow-lg", "label": "Shadow lg" }
            ],
            "default": "shadow-sm"
        },
        {
            "type": "select",
            "id": "layout_mobile",
            "label": "Layout - mobile",
            "options": [
                { "value": "navbar-mobile-simple", "label": "Simple" },
                { "value": "navbar-mobile-with-search", "label": "With search" },
                { "value": "navbar-mobile-bottom-bar", "label": "Bottom navigation bar" }
            ],
            "default": "navbar-mobile-with-search"
        },
        {
            "type": "select",
            "id": "layout_desktop",
            "label": "Layout - desktop",
            "options": [
                { "value": "navbar-desktop-logo-left", "label": "Classic (logo left)" },
                { "value": "navbar-desktop-logo-center", "label": "Split (logo center)" },
                { "value": "navbar-desktop-stacked", "label": "Stacked (multi-row)" }
            ],
            "default": "navbar-desktop-logo-left"
        },
        {
            "type": "checkbox",
            "id": "always_show_toggle",
            "label": "Always show the mobile toggler",
            "default": false
        },
        {
            "type": "header",
            "content": "Logo"
        },
        {
            "type": "image_picker",
            "id": "logo_mobile",
            "label": "Logo mobile"
        },
        {
            "type": "range",
            "id": "logo_height_mobile",
            "label": "Logo mobile height",
            "min": 20,
            "max": 100,
            "step": 2,
            "default": 40
        },
        {
            "type": "image_picker",
            "id": "logo",
            "label": "Logo desktop"
        },
        {
            "type": "range",
            "id": "logo_height_desktop",
            "label": "Logo desktop height",
            "min": 20,
            "max": 200,
            "step": 2,
            "default": 40
        },
        {
            "type": "header",
            "content": "Mobile menu"
        },
        {
            "type": "link_list",
            "id": "menu_mobile",
            "label": "Menu",
            "default": "main-menu"
        },
        {
            "type": "checkbox",
            "id": "mobile_menu_label",
            "label": "Mobile menu label",
            "default": true
        },
        {
            "type": "link_list",
            "id": "utilities_menu",
            "label": "Utilities menu"
        },
        {
            "type": "checkbox",
