{% liquid
  assign pt = section.settings.pt | prepend: 'pt-'
  assign pb = section.settings.pb | prepend: 'pb-'
  assign mt = section.settings.mt | prepend: 'mt-'
  assign mb = section.settings.mb | prepend: 'mb-'
  assign color_scheme_class = 'color-' | append: section.settings.color_scheme

  assign visibility_class = 'd-flex'
  if section.settings.visibility != blank and section.settings.visibility != nil
    assign visibility_class = section.settings.visibility
  endif

  assign list_modifier = ''
  if section.settings.timeline_style == 'line'
    assign list_modifier = 'brand-timeline__list--line'
  elsif section.settings.timeline_style == 'minimal'
    assign list_modifier = 'brand-timeline__list--minimal'
  endif

%}

<section
  id="brand-timeline-{{ section.id }}"
  class="brand-timeline brand-timeline--style-{{ section.settings.timeline_style }}{% if section.settings.enable_max_image_height %} brand-timeline--cap-image-height{% endif %} enter-view overflow-hidden {{ visibility_class }} flex-column justify-content-center {{ pt }} {{ pb }} {{ mt }} {{ mb }} {{ color_scheme_class }}"
  {% if section.settings.enable_max_image_height %}
    style="--bt-img-max-h-mobile: {{ section.settings.max_image_height_mobile }}px; --bt-img-max-h-lg: {{ section.settings.max_image_height_desktop }}px;"
  {% endif %}
>
  <div class="{{ section.settings.container }} {{ section.settings.text_align }}">
    {% render 'section-header', section: section %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="{{ section.settings.container }}">
      <ol
        class="list-unstyled brand-timeline__list {{ list_modifier }}"
        aria-label="{{ 'sections.brand_timeline.timeline_region_aria' | t }}"
      >
        {% for block in section.blocks %}
          {% render 'brand-timeline-milestone',
            section: section,
            block: block,
            milestone_index: forloop.index0,
            is_first: forloop.first
          %}
        {% endfor %}
      </ol>
    </div>
  {% endif %}
</section>

