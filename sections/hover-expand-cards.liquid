{% liquid
  assign pt = section.settings.pt | prepend: 'pt-'
  assign pb = section.settings.pb | prepend: 'pb-'
  assign mt = section.settings.mt | prepend: 'mt-'
  assign mb = section.settings.mb | prepend: 'mb-'

  assign row_sm = section.settings.grid_cols_sm | prepend: 'row-cols-'
  assign row_lg = section.settings.grid_cols_lg | prepend: 'row-cols-lg-'

  assign banner_height = section.settings.desktop_banner_height | append: ' ' | append: section.settings.mobile_banner_height

  assign color_scheme_class = 'color-' | append: section.settings.color_scheme
%}

<section
  class="image-card-grid {{ pt }} {{ pb }} {{ mt }} {{ mb }} {{ color_scheme_class }}
    {% if section.settings.visibility == 'd-flex' %}d-flex{% else %}{{ section.settings.visibility }}{% endif %}
    {% if customer and section.settings.showTo == 'guest' %}d-none{% elsif section.settings.showTo == 'customer' %}
     {% unless customer %}d-none{% endunless %}{% endif %}
  "
  id="image-card-grid-{{ section.id }}"
>
  <div class="{{ section.settings.container }}">
    <div class="row {{ row_sm }} {{ row_lg }} g-4">
      {% for block in section.blocks %}
        {% liquid
          assign alignment = block.settings.mobile_text_alignment | append: ' ' | append: block.settings.desktop_text_alignment
        %}
        <div class="col image-card-container enter-view" {{ block.shopify_attributes }}>
          <div class="hover-image-card-wrapper rounded position-relative overflow-hidden">
            <!-- Image -->
            <picture>
              <source
                media="(max-width: 768px)"
                srcset="{% if block.settings.mobile_image %}{{ block.settings.mobile_image | image_url: width: 375 }} 375w, {{ block.settings.mobile_image | image_url: width: 690 }} 690w{% endif %}"
                sizes="(max-width: 768px) 375px, 690px"
              >
              {% if block.settings.desktop_image %}
                <img
                  src="{{ block.settings.desktop_image | image_url: width: block.settings.desktop_image.width }}"
                  alt="{{ block.settings.desktop_image.alt | escape }}"
                  class="d-block w-100 object-fit-cover {{ banner_height }} image-card-img"
                  loading="lazy"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag: banner_height }}
              {% endif %}
            </picture>

            <!-- Overlay -->
            <div
              class="overlay position-absolute top-0 start-0 w-100 h-100"
              style="--overlay-color: {{ block.settings.overlay_color }}; --overlay-opacity: {{ block.settings.overlay_opacity }};"
            ></div>

            <!-- Content -->
            <div
              class="image-card-content position-absolute {{ block.settings.desktop_content_position }} {{ block.settings.mobile_content_position }} {{ alignment }} w-100 p-4"
            >
              {% render 'block-header', block: block, alignment: alignment %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Image hover cards",
  "settings": [
    { "type": "header", "content": "General Settings" },
    {
      "type": "select",
      "label": "Visible on",
      "id": "visibility",
      "default": "d-flex",
      "options": [
        { "value": "d-flex", "label": "All screen sizes" },
        { "value": "d-sm-none d-lg-flex", "label": "On desktop only" },
        { "value": "d-lg-none d-sm-flex", "label": "On mobile only" }
      ]
    },
    {
      "type": "select",
      "label": "Visible to",
      "id": "showTo",
      "default": "everyone",
      "info": "If you're not logged in within the customizer and you've chosen display to customers, it will not show within customizer.",
      "options": [
        { "label": "Logged in", "value": "customer" },
        { "label": "Guests only", "value": "guest" },
        { "label": "Everyone", "value": "everyone" }
      ]
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container-fluid no-gap",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid no-gap", "label": "Full width" }
      ]
    },
    { "type": "color_scheme", "label": "Color scheme", "id": "color_scheme" },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "animate__fadeInUp",
      "options": [
        { "group": "Disabled", "value": "", "label": "No animation" },
        { "group": "Fade", "value": "animate__fadeIn", "label": "Fade In" },
        { "group": "Fade", "value": "animate__fadeInDown", "label": "Fade-in-down" },
        { "group": "Fade", "value": "animate__fadeInLeft", "label": "Fade-in-left" },
        { "group": "Fade", "value": "animate__fadeInRight", "label": "Fade-in-right" },
        { "group": "Fade", "value": "animate__fadeInUp", "label": "Fade-in-up" },
        { "group": "Zoom", "value": "animate__zoomIn", "label": "Zoom-in" },
        { "group": "Zoom", "value": "animate__zoomInDown", "label": "Zoom-in-down" },
        { "group": "Zoom", "value": "animate__zoomInLeft", "label": "Zoom-in-left" },
        { "group": "Zoom", "value": "animate__zoomInRight", "label": "Zoom-in-right" },
        { "group": "Zoom", "value": "animate__zoomInUp", "label": "Zoom-in-up" },
        { "group": "Back", "value": "animate__backInDown", "label": "Back-in-down" },
        { "group": "Back", "value": "animate__backInLeft", "label": "Back-in-left" },
        { "group": "Back", "value": "animate__backInRight", "label": "Back-in-right" },
        { "group": "Back", "value": "animate__backInUp", "label": "Back-in-up" },
        { "group": "Bounce", "value": "animate__bounceIn", "label": "Bounce-in" },
        { "group": "Bounce", "value": "animate__bounceInDown", "label": "Bounce-in-down" },
        { "group": "Bounce", "value": "animate__bounceInLeft", "label": "Bounce-in-left" },
        { "group": "Bounce", "value": "animate__bounceInRight", "label": "Bounce-in-right" },
        { "group": "Bounce", "value": "animate__bounceInUp", "label": "Bounce-in-up" },
        { "group": "LightSpeed", "value": "animate__lightSpeedInLeft", "label": "LightSpeed-in-left" },
        { "group": "LightSpeed", "value": "animate__lightSpeedInRight", "label": "LightSpeed-in-right" }
      ]
    },
    {
      "type": "select",
      "id": "animation_speed",
      "label": "Animation speed",
      "default": "animate__fast",
      "options": [
        { "value": "animate__slower", "label": "Slower" },
        { "value": "animate__slow", "label": "Slow" },
        { "value": "", "label": "Normal" },
        { "value": "animate__fast", "label": "Fast" },
        { "value": "animate__faster", "label": "Faster" }
      ]
    },
    {
      "type": "select",
      "label": "Desktop image height",
      "id": "desktop_banner_height",
      "options": [
        { "label": "400px", "value": "h-d-400" },
        { "label": "500px", "value": "h-d-500" },
        { "label": "600px", "value": "h-d-600" },
        { "label": "700px", "value": "h-d-700" },
        { "label": "800px", "value": "h-d-800" },
        { "label": "Full screen", "value": "h-d-full" },
        { "label": "Adapt to first image", "value": "h-d-auto" }
      ],
      "default": "h-d-600"
    },
    {
      "type": "select",
      "label": "Mobile image height",
      "id": "mobile_banner_height",
      "options": [
        { "label": "400px", "value": "h-m-400" },
        { "label": "500px", "value": "h-m-500" },
        { "label": "600px", "value": "h-m-600" },
        { "label": "700px", "value": "h-m-700" },
        { "label": "800px", "value": "h-m-800" },
        { "label": "Full screen", "value": "h-m-full" },
        { "label": "Adapt to first image", "value": "h-m-auto" }
      ],
      "default": "h-m-400"
    },
    {
      "type": "range",
      "id": "grid_cols_sm",
      "label": "Cards per row (Mobile)",
      "min": 1,
      "max": 3,
      "default": 1,
      "step": 1
    },
    {
      "type": "range",
      "id": "grid_cols_lg",
      "label": "Cards per row (Desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    { "type": "header", "content": "Mobile layout" },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid (use setting above)" },
        { "value": "one", "label": "One per row" },
        { "value": "scroll", "label": "Horizontal scroll" }
      ]
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pt", "label": "Padding Top", "min": 0, "max": 20, "step": 1, "default": 10 },
    { "type": "range", "id": "pb", "label": "Padding Bottom", "min": 0, "max": 20, "step": 1, "default": 10 },
    { "type": "range", "id": "mt", "label": "Margin Top", "min": 0, "max": 20, "step": 1, "default": 0 },
    { "type": "range", "id": "mb", "label": "Margin Bottom", "min": 0, "max": 20, "step": 1, "default": 0 }
  ],
  "blocks": [
    {
      "name": "Image",
      "type": "image",
      "settings": [
        { "type": "image_picker", "label": "Desktop image", "id": "desktop_image" },
        { "type": "image_picker", "label": "Mobile image", "id": "mobile_image" },
        { "type": "header", "content": "Content" },
        { "type": "text", "label": "Subheading", "id": "subheader", "default": "Write an eye catching one liner" },
        { "type": "text", "label": "Heading", "id": "title", "default": "This is your heading text" },
        { "type": "textarea", "label": "Paragraph", "id": "description", "default": "This is your short description text" },
        { "type": "header", "content": "Buttons" },
        { "type": "header", "content": "Primary Button" },
        { "type": "url", "id": "p-btn-url", "label": "URL" },
        { "type": "text", "label": "Button label", "id": "p-btn-text", "default": "Primary button" },
        { "type": "select", "id": "p-btn-type", "label": "Button style", "options": [
          { "group": "Primary", "label": "Fill", "value": "btn-primary" },
          { "group": "Primary", "label": "Outline", "value": "btn-outline-primary" },
          { "group": "Secondary", "label": "Fill", "value": "btn-secondary" },
          { "group": "Secondary", "label": "Outline", "value": "btn-outline-secondary" }
        ], "default": "btn-primary" },
        { "type": "header", "content": "Secondary Button" },
        { "type": "url", "id": "s-btn-url", "label": "URL" },
        { "type": "text", "label": "Button label", "id": "s-btn-text", "default": "Secondary button" },
        { "type": "select", "id": "s-btn-type", "label": "Button style", "options": [
          { "group": "Primary", "label": "Fill", "value": "btn-primary" },
          { "group": "Primary", "label": "Outline", "value": "btn-outline-primary" },
          { "group": "Secondary", "label": "Fill", "value": "btn-secondary" },
          { "group": "Secondary", "label": "Outline", "value": "btn-outline-secondary" }
        ], "default": "btn-secondary" },
        { "type": "header", "content": "Positioning" },
        { "type": "select", "label": "Desktop content position", "id": "desktop_content_position", "options": [
          { "label": "Middle Left", "value": "position-middle-left" },
          { "label": "Middle Center", "value": "position-middle-center" },
          { "label": "Middle Right", "value": "position-middle-right" },
          { "label": "Top Center", "value": "position-top-center" },
          { "label": "Bottom Right", "value": "position-bottom-right" },
          { "label": "Bottom Left", "value": "position-bottom-left" }
        ], "default": "position-middle-center" },
        { "type": "select", "label": "Mobile content position", "id": "mobile_content_position", "options": [
          { "label": "Middle Center", "value": "position-mobile-middle-center" },
          { "label": "Top Center", "value": "position-mobile-top-center" },
          { "label": "Bottom Right", "value": "position-mobile-bottom-right" },
          { "label": "Bottom Left", "value": "position-mobile-bottom-left" }
        ], "default": "position-mobile-middle-center" },
        { "type": "header", "content": "Text Alignment" },
        { "type": "select", "label": "Desktop text alignment", "id": "desktop_text_alignment", "options": [
          { "label": "Left", "value": "text-lg-start center-left" },
          { "label": "Center", "value": "text-lg-center center-center" },
          { "label": "Right", "value": "text-lg-end center-right" }
        ], "default": "text-lg-start center-left" },
        { "type": "select", "label": "Mobile text alignment", "id": "mobile_text_alignment", "options": [
          { "label": "Left", "value": "text-start center-left" },
          { "label": "Center", "value": "text-center center-center" },
          { "label": "Right", "value": "text-end center-right" }
        ], "default": "text-center center-center" },
        { "type": "header", "content": "Font Sizes" },
        { "type": "range", "label": "Subheading Font Size (Mobile)", "id": "subheader_font_size_mobile", "min": 1, "max": 12, "step": 1, "default": 4 },
        { "type": "range", "label": "Subheading Font Size (Desktop)", "id": "subheader_font_size_desktop", "min": 1, "max": 12, "step": 1, "default": 6 },
        { "type": "range", "label": "Heading Font Size (Mobile)", "id": "title_font_size_mobile", "min": 1, "max": 12, "step": 1, "default": 8 },
        { "type": "range", "label": "Heading Font Size (Desktop)", "id": "title_font_size_desktop", "min": 1, "max": 12, "step": 1, "default": 10 },
        { "type": "range", "label": "Paragraph Font Size (Mobile)", "id": "description_font_size_mobile", "min": 1, "max": 12, "step": 1, "default": 5 },
        { "type": "range", "label": "Paragraph Font Size (Desktop)", "id": "description_font_size_desktop", "min": 1, "max": 12, "step": 1, "default": 8 },
        { "type": "header", "content": "Overlay" },
        { "type": "color", "id": "overlay_color", "label": "Overlay Color", "default": "#000000" },
        { "type": "range", "id": "overlay_opacity", "label": "Overlay Opacity", "min": 0, "max": 1, "step": 0.1, "default": 0.2, "info": "Set to 0 to hide" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image hover cards",
      "category": "Grid",
      "blocks": [ { "type": "image" }, { "type": "image" } ]
    }
  ]
}
{% endschema %}