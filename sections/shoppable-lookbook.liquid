{% liquid
  assign pt = section.settings.pt | prepend: 'pt-'
  assign pb = section.settings.pb | prepend: 'pb-'
  assign mt = section.settings.mt | prepend: 'mt-'
  assign mb = section.settings.mb | prepend: 'mb-'
  assign color_scheme_class = 'color-' | append: section.settings.color_scheme

  assign ratio_class = ''
  case section.settings.image_ratio
    when '1x1'
      assign ratio_class = 'ratio ratio-1x1'
    when '4x3'
      assign ratio_class = 'ratio ratio-4x3'
    when '16x9'
      assign ratio_class = 'ratio ratio-16x9'
    when '21x9'
      assign ratio_class = 'ratio ratio-21x9'
    else
      assign ratio_class = ''
  endcase
%}

<section
  class="{{ section.settings.visibility }} {{ color_scheme_class }} {{ pt }} {{ pb }} {{ mt }} {{ mb }}"
  data-lookbook-section="{{ section.id }}"
  data-lookbook-mobile-behavior="{{ section.settings.mobile_behavior }}"
  data-lookbook-pin-animation="{{ section.settings.pin_animation }}"
  style="--lookbook-pin-size: {{ section.settings.pin_size }}px; --lookbook-pin-color: {{ section.settings.pin_color }}; --lookbook-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="{{ section.settings.container }}">
    {% if section.settings.layout == 'image_only' %}
      {% render 'section-header', section: section %}
    {% endif %}

    <div class="{% if section.settings.layout == 'image_only' %}lookbook{% else %}lookbook lookbook--split{% endif %}">
      {% if section.settings.layout == 'image_only' %}
        <div class="lookbook__media-col">
          <div class="lookbook-media {% if ratio_class != blank %}{{ ratio_class }}{% endif %}">
            {% if section.settings.image != blank %}
              {{
                section.settings.image
                | image_url: width: 2400
                | image_tag:
                  widths: '375, 550, 750, 1100, 1500, 2000, 2400',
                  sizes: '(min-width: 992px) 960px, 100vw',
                  class: 'lookbook-img',
                  loading: 'lazy'
              }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'lookbook-placeholder' }}
            {% endif %}

            {% if section.settings.overlay %}
              <span class="lookbook-overlay" aria-hidden="true"></span>
            {% endif %}

            <div class="lookbook-pins" aria-label="{{ section.settings.pins_aria_label }}">
              {% for block in section.blocks %}
                {% if block.type != 'hotspot' %}
                  {% continue %}
                {% endif %}
                {% render 'lookbook-hotspot', section: section, block: block, forloop: forloop %}
              {% endfor %}
            </div>
          </div>
        </div>
      {% else %}
        <div class="row lookbook-split-row align-items-center">
          {% liquid
            assign media_col_order = ''
            assign copy_col_order = ''
            if section.settings.layout == 'split_right'
              assign media_col_order = 'order-lg-2'
              assign copy_col_order = 'order-lg-1'
            endif
          %}

          <div class="col-12 col-lg-6 {{ media_col_order }}">
            <div class="lookbook-media {% if ratio_class != blank %}{{ ratio_class }}{% endif %}">
              {% if section.settings.image != blank %}
                {{
                  section.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    widths: '375, 550, 750, 1100, 1500, 2000, 2400',
                    sizes: '(min-width: 992px) 50vw, 100vw',
                    class: 'lookbook-img',
                    loading: 'lazy'
                }}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'lookbook-placeholder' }}
              {% endif %}

              {% if section.settings.overlay %}
                <span class="lookbook-overlay" aria-hidden="true"></span>
              {% endif %}

              <div class="lookbook-pins" aria-label="{{ section.settings.pins_aria_label }}">
                {% for block in section.blocks %}
                  {% if block.type != 'hotspot' %}
                    {% continue %}
                  {% endif %}
                  {% render 'lookbook-hotspot', section: section, block: block, forloop: forloop %}
                {% endfor %}
              </div>
            </div>
          </div>

          <div class="col-12 col-lg-6 {{ copy_col_order }}">
            <div class="lookbook__copy text-start">
              {% render 'section-header', section: section %}

              {% if section.settings.button_label != blank and section.settings.button_link != blank %}
                <a class="btn btn-outline-primary mt-2" href="{{ section.settings.button_link }}">
                  {{ section.settings.button_label }}
                </a>
              {% endif %}

              {% if section.settings.enable_view_all and section.settings.view_all_collection != blank %}
                <div class="mt-4">
                  <a class="link-underline link-offset-2" href="{{ section.settings.view_all_collection.url }}">
                    {% liquid
                      assign view_all_text = section.settings.view_all_label
                      if view_all_text == blank
                        assign view_all_text = 'sections.featured_collection.view_all' | t
                      endif
                    %}
                    {{ view_all_text }}
                  </a>
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="lookbook-sheet" data-lookbook-sheet hidden>
    <div class="lookbook-sheet__backdrop" data-lookbook-close aria-hidden="true"></div>
    <div class="lookbook-sheet__panel" role="dialog" aria-modal="true">
      <div class="lookbook-sheet__header">
        <button type="button" class="lookbook-sheet__close btn btn-link p-0" data-lookbook-close>
          <span aria-hidden="true">&times;</span>
          <span class="visually-hidden">{{ 'sections.lookbook.close' | t }}</span>
        </button>
      </div>
      <div class="lookbook-sheet__body" data-lookbook-sheet-content></div>
    </div>
  </div>
</section>

{% schema %}
