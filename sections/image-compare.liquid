{% liquid
  assign color_scheme_class = 'color-' | append: section.settings.color_scheme
  assign img_1 = section.settings.image_1
  assign img_2 = section.settings.image_2
  assign img_w = 2400
  assign alt_before = 'sections.image_compare.image_before_alt' | t
  assign alt_after = 'sections.image_compare.image_after_alt' | t
  assign ar = 1.777777
  if img_1 and img_1.aspect_ratio
    assign ar = img_1.aspect_ratio
  elsif img_2 and img_2.aspect_ratio
    assign ar = img_2.aspect_ratio
  endif
  assign height_d = section.settings.image_height_desktop
  assign height_m = section.settings.image_height_mobile
  assign desktop_fixed = false
  assign mobile_fixed = false
  if height_d != 'auto'
    assign desktop_fixed = true
  endif
  if height_m != 'auto'
    assign mobile_fixed = true
  endif
  assign reveal = section.settings.reveal_direction
  assign anim_class = section.settings.animation | strip
  assign anim_speed = section.settings.animation_speed
  assign reveal_class = 'image-compare__before--' | append: reveal
%}

<section
  id="image-compare-{{ section.id }}"
  class="image-compare enter-view {% if section.settings.visibility == blank or section.settings.visibility == nil %}d-flex{% else %}{{ section.settings.visibility }}{% endif %} {{ color_scheme_class }}"
  style="--image-compare-ar: {{ ar }}; --hd: {{ height_d }}; --hm: {{ height_m }};"
>
  <div class="{{ section.settings.container }}">
    <div
      class="image-compare__viewport rounded {% unless anim_class == '' %}animate__animated opacity-0 {{ anim_speed }}{% endunless %}"
      data-reveal-direction="{{ reveal }}"
      data-animate-class="{{ anim_class }}"
      style="--compare: 0%; --compare-num: 0; animation-delay: 150ms;"
      data-image-compare
      data-compare-orientation="{{ reveal }}"
    >
      <div
        class="image-compare__media{% if mobile_fixed %} image-compare__media--mobile-fixed{% endif %}{% if desktop_fixed %} image-compare__media--desktop-fixed{% endif %}"
      >
        <div class="image-compare__layer image-compare__layer--after">
          {% if img_2 == blank %}
            <div class="image-compare__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: class: 'image-compare__placeholder-svg' }}
            </div>
          {% else %}
            {{
              img_2
              | image_url: width: img_w
              | image_tag:
                class: 'image-compare__img',
                widths: '375, 550, 750, 1100, 1500, 2200, 2400',
                sizes: '(min-width: 990px) min(90vw, 1400px), 100vw',
                loading: 'lazy',
                alt: alt_after,
                fetchpriority: 'low'
            }}
          {% endif %}
        </div>
        <div class="image-compare__layer image-compare__layer--before {{ reveal_class }}">
          {% if img_1 == blank %}
            <div class="image-compare__placeholder">
              {{ 'lifestyle-2' | placeholder_svg_tag: class: 'image-compare__placeholder-svg' }}
            </div>
          {% else %}
            {{
              img_1
              | image_url: width: img_w
              | image_tag:
                class: 'image-compare__img',
                widths: '375, 550, 750, 1100, 1500, 2200, 2400',
                sizes: '(min-width: 990px) min(90vw, 1400px), 100vw',
                loading: 'lazy',
                alt: alt_before,
                fetchpriority: 'low'
            }}
          {% endif %}
        </div>
        <input
          type="range"
          class="image-compare__range image-compare__range--{{ reveal }}"
          min="0"
          max="100"
          value="0"
          aria-label="{{ 'sections.image_compare.slider_label' | t }}"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          data-image-compare-input
        >
        <div
          class="image-compare__hit image-compare__hit--{{ reveal }}"
          data-image-compare-hit
          tabindex="-1"
        ></div>
        <div class="image-compare__line image-compare__line--{{ reveal }}" aria-hidden="true"></div>
        <div class="image-compare__handle image-compare__handle--{{ reveal }}" aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="30"
            height="30"
            fill="currentColor"
            viewBox="0 0 256 256"
            focusable="false"
          >
            <rect width="256" height="256" fill="none"></rect>
            <line
              x1="128"
              y1="40"
              x2="128"
              y2="216"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="16"
            ></line>
            <line
              x1="96"
              y1="128"
              x2="16"
              y2="128"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="16"
            ></line>
            <polyline
              points="48 160 16 128 48 96"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="16"
            ></polyline>
            <line
              x1="160"
              y1="128"
              x2="240"
              y2="128"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="16"
            ></line>
            <polyline
              points="208 96 240 128 208 160"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="16"
            ></polyline>
          </svg>
        </div>
        {% if section.settings.label_before != blank or section.settings.label_after != blank %}
          <div class="image-compare__labels image-compare__labels--{{ reveal }}">
            {% if section.settings.label_before != blank %}
              <span class="image-compare__label image-compare__label--before">{{ section.settings.label_before | escape }}</span>
            {% endif %}
            {% if section.settings.label_after != blank %}
              <span class="image-compare__label image-compare__label--after">{{ section.settings.label_after | escape }}</span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image comparison",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "label": "Visibility",
      "id": "visibility",
      "default": "d-flex",
      "options": [
        { "value": "d-flex", "label": "All screen sizes" },
        { "value": "d-sm-none d-lg-flex", "label": "On desktop only" },
        { "value": "d-lg-none d-sm-flex", "label": "On mobile only" }
      ]
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Full width" }
      ]
    },
    {
      "type": "color_scheme",
      "label": "Color scheme",
      "id": "color_scheme"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "animate__fadeInUp",
      "options": [
        { "group": "Disabled", "value": "", "label": "No animation" },
        { "group": "Fade", "value": "animate__fadeIn", "label": "Fade in" },
        { "group": "Fade", "value": "animate__fadeInDown", "label": "Fade-in-down" },
        { "group": "Fade", "value": "animate__fadeInLeft", "label": "Fade-in-left" },
        { "group": "Fade", "value": "animate__fadeInRight", "label": "Fade-in-right" },
        { "group": "Fade", "value": "animate__fadeInUp", "label": "Fade-in-up" },
        { "group": "Zoom", "value": "animate__zoomIn", "label": "Zoom-in" },
        { "group": "Zoom", "value": "animate__zoomInDown", "label": "Zoom-in-down" },
        { "group": "Zoom", "value": "animate__zoomInLeft", "label": "Zoom-in-left" },
        { "group": "Zoom", "value": "animate__zoomInRight", "label": "Zoom-in-right" },
        { "group": "Zoom", "value": "animate__zoomInUp", "label": "Zoom-in-up" },
        { "group": "Back", "value": "animate__backInDown", "label": "Back-in-down" },
        { "group": "Back", "value": "animate__backInLeft", "label": "Back-in-left" },
        { "group": "Back", "value": "animate__backInRight", "label": "Back-in-right" },
        { "group": "Back", "value": "animate__backInUp", "label": "Back-in-up" },
        { "group": "Bounce", "value": "animate__bounceIn", "label": "Bounce-in" },
        { "group": "Bounce", "value": "animate__bounceInDown", "label": "Bounce-in-down" },
        { "group": "Bounce", "value": "animate__bounceInLeft", "label": "Bounce-in-left" },
        { "group": "Bounce", "value": "animate__bounceInRight", "label": "Bounce-in-right" },
        { "group": "Bounce", "value": "animate__bounceInUp", "label": "Bounce-in-up" },
        { "group": "LightSpeed", "value": "animate__lightSpeedInLeft", "label": "LightSpeed-in-left" },
        { "group": "LightSpeed", "value": "animate__lightSpeedInRight", "label": "LightSpeed-in-right" }
      ]
    },
    {
      "type": "select",
      "id": "animation_speed",
      "label": "Animation speed",
      "default": "animate__fast",
      "options": [
        { "value": "animate__slower", "label": "Slower" },
        { "value": "animate__slow", "label": "Slow" },
        { "value": "", "label": "Normal" },
        { "value": "animate__fast", "label": "Fast" },
        { "value": "animate__faster", "label": "Faster" }
      ]
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "text",
      "id": "label_before",
      "label": "Before label",
      "default": "Before",
      "info": "Horizontal: bottom left. Vertical: top left."
    },
    {
      "type": "text",
      "id": "label_after",
      "label": "After label",
      "default": "After",
      "info": "Horizontal: bottom right. Vertical: bottom left."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Before image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "After image"
    },
    {
      "type": "select",
      "id": "reveal_direction",
      "label": "Reveal direction",
      "options": [
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "vertical", "label": "Vertical" }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "image_height_desktop",
      "label": "Image height (desktop)",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "200px", "label": "200px" },
        { "value": "300px", "label": "300px" },
        { "value": "400px", "label": "400px" },
        { "value": "500px", "label": "500px" },
        { "value": "600px", "label": "600px" },
        { "value": "700px", "label": "700px" },
        { "value": "100vh", "label": "100vh" }
      ]
    },
    {
      "type": "select",
      "id": "image_height_mobile",
      "label": "Image height (mobile)",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "200px", "label": "200px" },
        { "value": "300px", "label": "300px" },
        { "value": "400px", "label": "400px" },
        { "value": "500px", "label": "500px" },
        { "value": "600px", "label": "600px" },
        { "value": "700px", "label": "700px" },
        { "value": "100vh", "label": "100vh" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image comparison"
    }
  ]
}
{% endschema %}
